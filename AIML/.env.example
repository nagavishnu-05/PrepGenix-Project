# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=interview_assessment

# Backend API (if integrating with Express backend)
BACKEND_API_URL=http://localhost:3000

# File Upload
MAX_FILE_SIZE=52428800  # 50MB in bytes
UPLOAD_TEMP_DIR=/tmp

# Models Configuration
USE_GPU=False
MODEL_PRECISION=float32

# Attention sensitivity (a condition must persist across this many monitoring
# cycles AND for this many seconds before it is recorded as a violation).
GAZE_CONFIRMATION_FRAMES=5
HEAD_TURNED_CONFIRMATION_FRAMES=5
GAZE_HOLD_SECONDS=2.0
HEAD_TURNED_HOLD_SECONDS=7.0

# Prohibited object / device detection (YOLOv8 COCO scene pass)
PROCTORING_OBJECT_DETECTION_ENABLED=true
DEVICE_DETECTION_IMGSZ=640
# Per-class confidence floors; phones score low when held close to the webcam.
DEVICE_CONF_PHONE=0.18
DEVICE_CONF_REMOTE=0.18
DEVICE_CONF_LAPTOP=0.35
DEVICE_CONF_KEYBOARD=0.35
DEVICE_CONF_TV=0.40
DEVICE_CONF_BOOK=0.45
