# Copy to Backend/.env and fill in. Values shown are the defaults used in code.

# --- Core ---
PORT=8080
FRONTEND_URL=http://localhost:5173
DATABASE_URL=mongodb://localhost:27017/codeassess
DB_NAME=codeassess
RESUME_DATABASE_URL=mongodb://localhost:27017/codeassess_resumes
RESUME_DB=codeassess_resumes
PERF_DB=codeassess_perf
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=24h

# --- Supabase Storage (optional; images/recordings disabled if unset) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_FRAME_BUCKET=proctoring-frames
# SUPABASE_REFERENCE_BUCKET=proctoring-reference
# SUPABASE_PROFILE_BUCKET=student-profiles
# SUPABASE_RECORDING_BUCKET=interview-recordings
# SUPABASE_SIGNED_URL_TTL_SEC=900

# --- Proctoring (AIML scripts) ---
# PYTHON_PATH=python

# --- LLM for resume-based interview features (optional) ---
# If no key is configured, question planning and reporting fall back to a
# deterministic, resume-grounded heuristic so the feature still works offline.
# LLM_PROVIDER is optional; without it the first provider with a key is used.
# Set LLM_PROVIDER=none to force the heuristic path.
LLM_PROVIDER=
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash
# LLM_TIMEOUT_MS=45000

# --- Interview consent & recording ---
# INTERVIEW_CONSENT_VERSION=2026-01
# Days before an opt-in interview recording is automatically deleted. 0 disables.
# INTERVIEW_RECORDING_RETENTION_DAYS=30
